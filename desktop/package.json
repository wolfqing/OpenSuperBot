{
  "name": "@opensuperbot/desktop",
  "productName": "OpenSuperBot",
  "desktopName": "opensuperbot.desktop",
  "version": "0.6.0-dev",
  "private": true,
  "description": "OpenSuperBot desktop app: hosts the gateway and shows the UI in a window",
  "type": "module",
  "main": "dist/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "electron .",
    "install-electron": "node node_modules/electron/install.js",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "package": "electron-builder --config electron-builder.config.cjs",
    "package:mac": "electron-builder --config electron-builder.config.cjs --mac",
    "package:linux": "electron-builder --config electron-builder.config.cjs --linux",
    "package:linux:x64": "electron-builder --config electron-builder.config.cjs --linux AppImage deb --x64",
    "package:linux:arm64": "electron-builder --config electron-builder.config.cjs --linux AppImage deb --arm64"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "44.9.3",
    "electron-builder": "26.18.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "homepage": "https://github.com/wolfqing/OpenSuperBot",
  "author": "wolfqing",
  "license": "MIT"
}
