abi <abi/4.0>,
include <tunables/global>

profile "${executable}" "/opt/${sanitizedProductName}/${executable}" flags=(unconfined) {
  userns,

  include if exists <local/${executable}>
}

profile "${executable}-browser" @{HOME}/.local/share/OpenSuperBot/data/browsers/chromium-*/chrome-linux*/chrome flags=(unconfined) {
  userns,

  include if exists <local/${executable}-browser>
}
