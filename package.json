{
  "name": "opensuperbot",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @opensuperbot/gateway --filter @opensuperbot/web dev",
    "build": "pnpm --filter @opensuperbot/web build && pnpm --filter @opensuperbot/gateway build",
    "start": "pnpm --filter @opensuperbot/gateway start",
    "desktop": "pnpm build && pnpm --filter @opensuperbot/desktop build && pnpm --filter @opensuperbot/desktop start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "desktop:package": "node desktop/scripts/stage.mjs && pnpm --filter @opensuperbot/desktop package",
    "smoke:desktop": "pnpm --filter @opensuperbot/gateway exec tsx ../scripts/smoke-desktop.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "better-sqlite3",
      "cpu-features",
      "electron",
      "electron-winstaller",
      "protobufjs",
      "ssh2"
    ]
  }
}
